{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-explainer-studio.local/schemas/derived-generation-input.schema.json",
  "title": "DerivedGenerationInput",
  "type": "object",
  "required": [
    "project_id",
    "scene_id",
    "asset_id",
    "entity_ids",
    "visual_goal",
    "reference_assets",
    "visual_transforms",
    "preserved_features",
    "forbidden_variations",
    "continuity_constraints",
    "output_spec",
    "attempt"
  ],
  "properties": {
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "scene_id": {
      "type": "string",
      "pattern": "^S[0-9]+$"
    },
    "asset_id": {
      "type": "string",
      "pattern": "^A[0-9]+$"
    },
    "entity_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "visual_goal": {
      "type": "string",
      "minLength": 1
    },
    "reference_assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "image-asset.schema.json"
      }
    },
    "visual_transforms": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "preserved_features": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "forbidden_variations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "continuity_constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "technical_constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "output_spec": {
      "type": "object",
      "required": [
        "aspect_ratio",
        "width",
        "height"
      ],
      "properties": {
        "aspect_ratio": {
          "type": "string",
          "enum": [
            "9:16",
            "16:9",
            "1:1"
          ]
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "transparent_background": {
          "type": "boolean",
          "default": false
        }
      },
      "additionalProperties": false
    },
    "attempt": {
      "type": "integer",
      "minimum": 0
    }
  },
  "additionalProperties": false
}