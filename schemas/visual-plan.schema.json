{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-explainer-studio.local/schemas/visual-plan.schema.json",
  "title": "VisualPlan",
  "type": "object",
  "required": [
    "visual_plan_id",
    "asset_bible",
    "routes",
    "lineage",
    "transitions",
    "global_continuity_rules"
  ],
  "properties": {
    "visual_plan_id": {
      "type": "string",
      "minLength": 1
    },
    "asset_bible": {
      "$ref": "asset-bible.schema.json"
    },
    "routes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "visual-route-decision.schema.json"
      }
    },
    "lineage": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "scene-lineage.schema.json"
      }
    },
    "transitions": {
      "type": "array",
      "items": {
        "$ref": "transition-spec.schema.json"
      }
    },
    "global_continuity_rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "production_notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}