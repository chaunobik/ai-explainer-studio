{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-explainer-studio.local/schemas/image-asset.schema.json",
  "title": "ImageAsset",
  "type": "object",
  "required": [
    "asset_id",
    "project_id",
    "asset_role",
    "status",
    "entity_ids",
    "parent_asset_ids",
    "attempt",
    "provenance",
    "file"
  ],
  "properties": {
    "asset_id": {
      "type": "string",
      "pattern": "^A[0-9]+$"
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "scene_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^S[0-9]+$"
    },
    "asset_role": {
      "type": "string",
      "enum": [
        "anchor",
        "derived"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "planned",
        "awaiting_generation",
        "awaiting_import",
        "qa_pending",
        "approved",
        "rejected",
        "needs_human_review"
      ]
    },
    "entity_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "parent_asset_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^A[0-9]+$"
      }
    },
    "attempt": {
      "type": "integer",
      "minimum": 0
    },
    "provenance": {
      "type": "object",
      "required": [
        "provider_id",
        "provider_mode",
        "operation"
      ],
      "properties": {
        "provider_id": {
          "type": "string",
          "minLength": 1
        },
        "provider_mode": {
          "type": "string",
          "enum": [
            "manual",
            "api",
            "import"
          ]
        },
        "operation": {
          "type": "string",
          "enum": [
            "generate_anchor",
            "derive_scene",
            "import_existing"
          ]
        },
        "source_uri": {
          "type": [
            "string",
            "null"
          ]
        },
        "prompt_snapshot": {
          "type": [
            "string",
            "null"
          ]
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "file": {
      "type": "object",
      "required": [
        "uri",
        "mime_type",
        "width",
        "height"
      ],
      "properties": {
        "uri": {
          "type": [
            "string",
            "null"
          ]
        },
        "mime_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "width": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "height": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "checksum": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "qa_result_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}