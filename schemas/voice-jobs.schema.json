{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-explainer-studio.local/schemas/voice-jobs.schema.json",
  "title": "VoiceJobs",
  "type": "object",
  "required": [
    "project_id",
    "jobs"
  ],
  "properties": {
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "jobs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "voice-provider-job.schema.json"
      }
    }
  },
  "additionalProperties": false
}