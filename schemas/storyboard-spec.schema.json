{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-explainer-studio.local/schemas/storyboard-spec.schema.json",
  "title": "StoryboardSpec",
  "type": "object",
  "required": [
    "storyboard_id",
    "target_duration_sec",
    "scenes"
  ],
  "properties": {
    "storyboard_id": {
      "type": "string",
      "minLength": 1
    },
    "target_duration_sec": {
      "type": "number",
      "minimum": 30,
      "maximum": 90
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "$ref": "scene-spec.schema.json"
      }
    },
    "total_duration_sec": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "continuity_notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "feasibility_notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}