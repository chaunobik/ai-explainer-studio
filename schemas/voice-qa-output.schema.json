{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-explainer-studio.local/schemas/voice-qa-output.schema.json",
  "title": "VoiceQAOutput",
  "type": "object",
  "required": [
    "qa_result",
    "scene_checks",
    "repair_actions"
  ],
  "properties": {
    "qa_result": {
      "$ref": "qa-result.schema.json"
    },
    "scene_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "scene_id",
          "status",
          "issues"
        ],
        "properties": {
          "scene_id": {
            "type": "string",
            "pattern": "^S[0-9]+$"
          },
          "status": {
            "type": "string",
            "enum": [
              "pass",
              "fail",
              "needs_review"
            ]
          },
          "issues": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "repair_actions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}