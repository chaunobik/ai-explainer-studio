{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-explainer-studio.local/schemas/multiview-reference-prompt-spec.schema.json",
  "title": "MultiViewReferencePromptSpec",
  "type": "object",
  "required": [
    "project_id",
    "prompt_id",
    "asset_id",
    "operation",
    "capture_profile",
    "subject_lock",
    "required_views",
    "environment",
    "board_composition",
    "cross_view_consistency_rules",
    "realism_rules",
    "technical_constraints",
    "negative_constraints",
    "output_spec",
    "final_prompt"
  ],
  "properties": {
    "project_id": {"type": "string", "minLength": 1},
    "prompt_id": {"type": "string", "pattern": "^MVP[0-9]+$"},
    "asset_id": {"type": "string", "pattern": "^A[0-9]+$"},
    "operation": {"const": "generate_reference_pack"},
    "capture_profile": {"$ref": "photo-capture-spec.schema.json"},
    "subject_lock": {
      "type": "object",
      "required": ["entity_ids", "canonical_description", "must_preserve", "must_not_change"],
      "properties": {
        "entity_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "canonical_description": {"type": "string", "minLength": 1},
        "must_preserve": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "must_not_change": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "required_views": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["view_id", "label", "yaw_degrees", "pitch_degrees", "framing", "purpose"],
        "properties": {
          "view_id": {
            "type": "string",
            "enum": [
              "front",
              "front_left_45",
              "front_right_45",
              "left",
              "right",
              "rear_left_45",
              "rear_right_45",
              "rear",
              "top",
              "interior",
              "detail"
            ]
          },
          "label": {"type": "string", "minLength": 1},
          "yaw_degrees": {"type": "number", "minimum": -180, "maximum": 180},
          "pitch_degrees": {"type": "number", "minimum": -90, "maximum": 90},
          "framing": {"type": "string", "minLength": 1},
          "purpose": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "environment": {
      "type": "object",
      "required": ["location", "background", "floor", "lighting_continuity"],
      "properties": {
        "location": {"type": "string"},
        "background": {"type": "string"},
        "floor": {"type": "string"},
        "lighting_continuity": {"type": "string"}
      },
      "additionalProperties": false
    },
    "board_composition": {
      "type": "object",
      "required": ["layout", "panel_rules", "labels", "crop_rules"],
      "properties": {
        "layout": {"type": "string"},
        "panel_rules": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "labels": {"type": "string"},
        "crop_rules": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "cross_view_consistency_rules": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "realism_rules": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "technical_constraints": {"type": "array", "items": {"type": "string"}},
    "negative_constraints": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "output_spec": {
      "type": "object",
      "required": ["aspect_ratio", "width", "height"],
      "properties": {
        "aspect_ratio": {"type": "string", "enum": ["16:9", "4:3", "1:1"]},
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "transparent_background": {"type": "boolean", "default": false}
      },
      "additionalProperties": false
    },
    "final_prompt": {"type": "string", "minLength": 500}
  },
  "additionalProperties": false
}