{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-explainer-studio.local/schemas/image-prompt-spec.schema.json",
  "title": "ImagePromptSpec",
  "type": "object",
  "required": [
    "project_id",
    "prompt_id",
    "asset_id",
    "scene_id",
    "operation",
    "reference_asset_ids",
    "subject_lock",
    "scene_intent",
    "camera",
    "composition",
    "environment",
    "lighting",
    "appearance",
    "required_visual_elements",
    "allowed_transforms",
    "technical_constraints",
    "continuity_constraints",
    "negative_constraints",
    "output_spec",
    "final_prompt"
  ],
  "properties": {
    "prompt_id": {
      "type": "string",
      "pattern": "^IP[0-9]+$"
    },
    "asset_id": {
      "type": "string",
      "pattern": "^A[0-9]+$"
    },
    "scene_id": {
      "type": "string",
      "pattern": "^S[0-9]+$"
    },
    "operation": {
      "type": "string",
      "enum": [
        "generate_anchor",
        "derive_scene"
      ]
    },
    "reference_asset_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^A[0-9]+$"
      }
    },
    "subject_lock": {
      "type": "object",
      "required": [
        "entity_ids",
        "canonical_description",
        "must_preserve",
        "must_not_change"
      ],
      "properties": {
        "entity_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "canonical_description": {
          "type": "string",
          "minLength": 1
        },
        "must_preserve": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "must_not_change": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "scene_intent": {
      "type": "object",
      "required": [
        "narration",
        "visual_goal",
        "viewer_should_understand"
      ],
      "properties": {
        "narration": {
          "type": "string"
        },
        "visual_goal": {
          "type": "string",
          "minLength": 1
        },
        "viewer_should_understand": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "camera": {
      "type": "object",
      "required": [
        "view",
        "angle",
        "distance",
        "height",
        "framing",
        "perspective"
      ],
      "properties": {
        "view": {
          "type": "string"
        },
        "angle": {
          "type": "string"
        },
        "distance": {
          "type": "string"
        },
        "height": {
          "type": "string"
        },
        "framing": {
          "type": "string"
        },
        "perspective": {
          "type": "string"
        },
        "lens_style": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "composition": {
      "type": "object",
      "required": [
        "subject_position",
        "crop_rules",
        "background_visibility",
        "negative_space"
      ],
      "properties": {
        "subject_position": {
          "type": "string"
        },
        "crop_rules": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "background_visibility": {
          "type": "string"
        },
        "negative_space": {
          "type": "string"
        },
        "layering": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "environment": {
      "type": "object",
      "required": [
        "location",
        "fixed_elements",
        "allowed_changes",
        "forbidden_changes"
      ],
      "properties": {
        "location": {
          "type": "string"
        },
        "fixed_elements": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "allowed_changes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "forbidden_changes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "lighting": {
      "type": "object",
      "required": [
        "style",
        "direction",
        "intensity",
        "consistency_rules"
      ],
      "properties": {
        "style": {
          "type": "string"
        },
        "direction": {
          "type": "string"
        },
        "intensity": {
          "type": "string"
        },
        "color_temperature": {
          "type": "string"
        },
        "consistency_rules": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "appearance": {
      "type": "object",
      "required": [
        "materials",
        "surface_finish",
        "realism_notes"
      ],
      "properties": {
        "materials": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "surface_finish": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "realism_notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "required_visual_elements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "element",
          "placement",
          "state",
          "purpose"
        ],
        "properties": {
          "element": {
            "type": "string"
          },
          "placement": {
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "purpose": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "technical_overlay": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "overlay_type": {
          "type": "string"
        },
        "elements": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "directions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "labels": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "must_not_imply": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "allowed_transforms": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "technical_constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "continuity_constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "negative_constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "output_spec": {
      "type": "object",
      "required": [
        "aspect_ratio",
        "width",
        "height"
      ],
      "properties": {
        "aspect_ratio": {
          "type": "string",
          "enum": [
            "9:16",
            "16:9",
            "1:1"
          ]
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "transparent_background": {
          "type": "boolean",
          "default": false
        }
      },
      "additionalProperties": false
    },
    "final_prompt": {
      "type": "string",
      "minLength": 200
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "reference_view_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "additionalProperties": false
}