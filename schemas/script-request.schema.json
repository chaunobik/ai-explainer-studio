{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-explainer-studio.local/schemas/script-request.schema.json",
  "title": "ScriptRequest",
  "type": "object",
  "required": [
    "project_id",
    "topic",
    "language",
    "target_duration_sec",
    "audience",
    "claims"
  ],
  "properties": {
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "topic": {
      "type": "string",
      "minLength": 1
    },
    "language": {
      "type": "string",
      "const": "vi-VN"
    },
    "target_duration_sec": {
      "type": "number",
      "minimum": 30,
      "maximum": 90
    },
    "audience": {
      "type": "string",
      "minLength": 1
    },
    "style": {
      "type": "string",
      "default": "curious_explorer"
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "claim.schema.json"
      }
    },
    "must_include": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "must_avoid": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tone_notes": {
      "type": "string"
    }
  },
  "additionalProperties": false
}