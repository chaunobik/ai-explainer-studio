{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-explainer-studio.local/schemas/multiview-qa-output.schema.json",
  "title": "MultiViewQAOutput",
  "type": "object",
  "required": [
    "qa_result",
    "reference_prompt_id",
    "asset_id",
    "checks",
    "view_results",
    "critical_violations",
    "repair_actions"
  ],
  "properties": {
    "qa_result": {"$ref": "qa-result.schema.json"},
    "reference_prompt_id": {"type": "string", "pattern": "^MVP[0-9]+$"},
    "asset_id": {"type": "string", "pattern": "^A[0-9]+$"},
    "checks": {
      "type": "object",
      "required": [
        "same_object_identity",
        "geometry_consistency",
        "material_consistency",
        "required_view_coverage",
        "camera_plausibility",
        "photographic_realism",
        "technical_safety"
      ],
      "properties": {
        "same_object_identity": {"type": "string", "enum": ["pass", "fail", "needs_review"]},
        "geometry_consistency": {"type": "string", "enum": ["pass", "fail", "needs_review"]},
        "material_consistency": {"type": "string", "enum": ["pass", "fail", "needs_review"]},
        "required_view_coverage": {"type": "string", "enum": ["pass", "fail", "needs_review"]},
        "camera_plausibility": {"type": "string", "enum": ["pass", "fail", "needs_review"]},
        "photographic_realism": {"type": "string", "enum": ["pass", "fail", "needs_review"]},
        "technical_safety": {"type": "string", "enum": ["pass", "fail", "needs_review"]}
      },
      "additionalProperties": false
    },
    "view_results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["view_id", "status", "notes"],
        "properties": {
          "view_id": {"type": "string"},
          "status": {"type": "string", "enum": ["pass", "fail", "needs_review"]},
          "notes": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "critical_violations": {"type": "array", "items": {"type": "string"}},
    "repair_actions": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}