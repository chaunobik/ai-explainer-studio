{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-explainer-studio.local/schemas/voice-spec.schema.json",
  "title": "VoiceSpec",
  "type": "object",
  "required": [
    "voice_plan_id",
    "project_id",
    "language",
    "provider_id",
    "segments"
  ],
  "properties": {
    "voice_plan_id": {
      "type": "string",
      "minLength": 1
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "language": {
      "type": "string",
      "const": "vi-VN"
    },
    "provider_id": {
      "type": "string",
      "minLength": 1
    },
    "style": {
      "type": "object",
      "properties": {
        "persona": {
          "type": "string"
        },
        "pace": {
          "type": "string"
        },
        "energy": {
          "type": "string"
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "pronunciation_dictionary": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "term",
          "pronunciation"
        ],
        "properties": {
          "term": {
            "type": "string",
            "minLength": 1
          },
          "pronunciation": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "scene_id",
          "text",
          "target_duration_sec",
          "output_asset_id"
        ],
        "properties": {
          "scene_id": {
            "type": "string",
            "pattern": "^S[0-9]+$"
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "target_duration_sec": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "output_asset_id": {
            "type": "string",
            "pattern": "^V[0-9]+$"
          },
          "delivery_notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}