{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-explainer-studio.local/schemas/photo-capture-spec.schema.json",
  "title": "PhotoCaptureSpec",
  "type": "object",
  "required": [
    "capture_profile_id",
    "capture_mode",
    "device_class",
    "lens_equivalent_mm",
    "aperture_f",
    "shutter_speed",
    "iso",
    "white_balance_kelvin",
    "camera_height_m",
    "subject_distance_m",
    "focus",
    "exposure",
    "lighting",
    "processing",
    "realism_rules"
  ],
  "properties": {
    "capture_profile_id": {"type": "string", "pattern": "^CAP[0-9]+$"},
    "capture_mode": {"type": "string", "enum": ["smartphone", "camera"]},
    "device_class": {"type": "string", "minLength": 1},
    "lens_equivalent_mm": {"type": "number", "minimum": 18, "maximum": 120},
    "aperture_f": {"type": "number", "exclusiveMinimum": 0},
    "shutter_speed": {"type": "string", "pattern": "^1/[0-9]+s$"},
    "iso": {"type": "integer", "minimum": 25, "maximum": 6400},
    "white_balance_kelvin": {"type": "integer", "minimum": 2500, "maximum": 9000},
    "camera_height_m": {"type": "number", "exclusiveMinimum": 0},
    "subject_distance_m": {"type": "number", "exclusiveMinimum": 0},
    "focus": {"type": "string", "minLength": 1},
    "exposure": {"type": "string", "minLength": 1},
    "lighting": {"type": "string", "minLength": 1},
    "stabilization": {"type": "string"},
    "processing": {"type": "string", "minLength": 1},
    "realism_rules": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"}
    }
  },
  "additionalProperties": false
}