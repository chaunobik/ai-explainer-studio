# AI Explainer Studio provider configuration
#
# Copy this file to .env and edit paths for your machine.

# ---------------------------------------------------------------------------
# ComfyUI — REQUIRED for generated image/keyframe assets
# ---------------------------------------------------------------------------
COMFYUI_BASE_URL=http://127.0.0.1:8188

# Exact filename under ComfyUI/models/checkpoints/
# Use a photorealistic SD/SDXL-compatible checkpoint that works with
# CheckpointLoaderSimple.
COMFYUI_CHECKPOINT=

# Optional: create-video will start ComfyUI automatically if health check fails.
# Example:
# COMFYUI_START_COMMAND=python D:\AI\ComfyUI\main.py --listen 127.0.0.1 --port 8188
COMFYUI_START_COMMAND=

IMAGE_WIDTH=1024
IMAGE_HEIGHT=1536
IMAGE_STEPS=28
IMAGE_CFG=6
IMAGE_SAMPLER=dpmpp_2m
IMAGE_SCHEDULER=karras
IMAGE_DENOISE=0.42
COMFYUI_TIMEOUT_MS=900000
COMFYUI_NEGATIVE_PROMPT=text, watermark, logo, duplicate object, deformed geometry, inconsistent product design

# ---------------------------------------------------------------------------
# VieNeu-TTS v3 Turbo — REQUIRED for Vietnamese narration
# ---------------------------------------------------------------------------
VIENEU_BASE_URL=http://127.0.0.1:8000
VIENEU_VOICE=Mai Anh
VIENEU_API_KEY=

# Example when VieNeu was cloned locally and installed with uv:
# VIENEU_START_COMMAND=cd /d D:\AI\vieneu-tts && uv run python -m apps.openai_speech
VIENEU_START_COMMAND=

# ---------------------------------------------------------------------------
# Wan2.2 — OPTIONAL; if unavailable, media router falls back to Remotion motion
# ---------------------------------------------------------------------------
WAN_REPO_DIR=
WAN_MODEL_DIR=
WAN_PYTHON=python

# Recommended consumer-GPU path from the official Wan2.2 project:
WAN_TASK=ti2v-5B
WAN_SIZE=704*1280

# ---------------------------------------------------------------------------
# Runtime output
# ---------------------------------------------------------------------------
MEDIA_OUTPUT_DIR=.ai-explainer/media
