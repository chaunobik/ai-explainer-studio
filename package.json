{
  "name": "ai-explainer-studio",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc -b packages/core",
    "build:core": "tsc -b packages/core",
    "test": "vitest run",
    "validate:schemas": "node scripts/validate-schemas.mjs",
    "validate:examples": "node scripts/validate-examples.mjs",
    "dry-run": "tsx scripts/dry-run.ts",
    "check": "npm run typecheck && npm run validate:schemas && npm run test && npm run validate:examples && npm run dry-run"
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "vitest": "^3.2.4",
    "tsx": "^4.20.5",
    "@types/node": "^22.10.0"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  }
}