{
  "name": "ai-explainer-studio",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc -b packages/core packages/renderer && npm run web:typecheck",
    "build:core": "tsc -b packages/core",
    "test": "vitest run",
    "validate:schemas": "node scripts/validate-schemas.mjs",
    "validate:examples": "node scripts/validate-examples.mjs",
    "dry-run": "tsx scripts/dry-run.ts",
    "autopilot": "tsx scripts/autopilot.ts",
    "check": "npm run typecheck && npm run validate:schemas && npm run test && npm run validate:examples && npm run project:doctor && npm run validate:motion && npm run validate:voice-plan && npm run dry-run && npm run project:status -- --ci",
    "validate:motion": "tsx scripts/validate-motion.ts",
    "render:scene": "tsx scripts/render-scene.ts",
    "validate:voice-plan": "tsx scripts/validate-voice-plan.ts",
    "render:project": "tsx scripts/render-project.ts",
    "project:status": "tsx scripts/project-status.ts",
    "project:doctor": "tsx scripts/project-doctor.ts",
    "image:import": "tsx scripts/import-image.ts",
    "image:status": "tsx scripts/set-image-status.ts",
    "voice:import": "tsx scripts/import-voice.ts",
    "voice:status": "tsx scripts/set-voice-status.ts",
    "render:smoke": "tsx scripts/render-smoke.ts",
    "dev": "npm --workspace @ai-explainer-studio/web run dev",
    "web:typecheck": "npm --workspace @ai-explainer-studio/web run typecheck",
    "web:build": "npm --workspace @ai-explainer-studio/web run build",
    "create-video": "tsx scripts/create-video.ts",
    "provider:ensure": "tsx scripts/ensure-providers.ts",
    "provider:doctor": "tsx scripts/provider-doctor.ts",
    "image:generate": "tsx scripts/generate-image.ts",
    "voice:generate": "tsx scripts/generate-voice.ts",
    "video:generate": "tsx scripts/generate-video.ts",
    "video:status": "tsx scripts/set-video-status.ts"
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "vitest": "^3.2.4",
    "tsx": "^4.20.5",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "@remotion/bundler": "^4.0.0",
    "@remotion/renderer": "^4.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.0"
  }
}
